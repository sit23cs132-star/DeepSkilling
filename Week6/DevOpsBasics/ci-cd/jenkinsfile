pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh 'docker build -t week6-app .'
            }
        }
        stage('Test') {
            steps {
                sh 'pytest'
            }
        }
        stage('Deploy') {
            steps {
                sh 'docker run -d -p 5000:5000 week6-app'
            }
        }
    }
}
